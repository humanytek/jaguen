<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sección "Portal de Lealtad" en el formulario de Contactos, justo
         arriba del notebook de pestañas (en el formulario estándar de
         JAGUEN esto queda debajo del bloque "QUE LINEAS COMPRAN"). -->
    <record id="view_partner_form_jaguen_loyalty" model="ir.ui.view">
        <field name="name">res.partner.form.jaguen.loyalty.portal</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <notebook position="before">
                <group string="Portal de Lealtad (Mis Puntos)" name="jaguen_loyalty_portal">
                    <group>
                        <field name="x_objetivo_anual_programa2"/>
                    </group>
                    <group>
                        <field name="x_terminos_portal_respondido" readonly="1" force_save="1"/>
                        <field name="x_terminos_portal_fecha" readonly="1" force_save="1"/>
                        <field name="x_acepta_incentivos_personales"/>
                        <field name="x_acepta_rebate_anual"/>
                    </group>
                </group>
            </notebook>
        </field>
    </record>
</odoo>
