<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="apihub_product_link_view_list" model="ir.ui.view">
        <field name="name">apihub.product.link.list</field>
        <field name="model">apihub.product.link</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'approved'" decoration-muted="state == 'rejected'">
                <field name="default_code"/>
                <field name="product_tmpl_id"/>
                <field name="our_description_purchase"/>
                <field name="provider_id"/>
                <field name="provider_code"/>
                <field name="provider_description"/>
                <field name="brand"/>
                <field name="brand_in_name" widget="badge" decoration-success="brand_in_name == 'si'"
                       decoration-danger="brand_in_name == 'no'"/>
                <field name="code_match" widget="badge" decoration-success="code_match in ('si', 'desc')"
                       decoration-warning="code_match == 'parcial'" decoration-danger="code_match == 'no'"/>
                <field name="multiplier"/>
                <field name="price_has_tax" optional="show"/>
                <field name="cost_reference"/>
                <field name="cost_provider_raw"/>
                <field name="state" column_invisible="True"/>
                <button name="action_approve" type="object" string="Aprobar" icon="fa-check text-success"
                        invisible="state in ('approved', 'rejected')"/>
                <button name="action_reject" type="object" string="Rechazar" icon="fa-times text-danger"
                        invisible="state in ('approved', 'rejected')"/>
            </list>
        </field>
    </record>

    <record id="apihub_product_link_view_form" model="ir.ui.view">
        <field name="name">apihub.product.link.form</field>
        <field name="model">apihub.product.link</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Aprobar" class="btn-primary"
                            invisible="state in ('approved', 'rejected')"/>
                    <button name="action_reject" type="object" string="Rechazar"
                            invisible="state in ('approved', 'rejected')"/>
                    <button name="action_reopen" type="object" string="Volver a revisar"
                            invisible="state not in ('approved', 'rejected')"/>
                    <field name="state" widget="statusbar" statusbar_visible="review,approved"/>
                </header>
                <sheet>
                    <group>
                        <group string="Producto en Odoo">
                            <field name="product_tmpl_id"/>
                            <field name="default_code"/>
                            <field name="our_description_purchase"/>
                            <field name="our_description_sale"/>
                            <field name="cost_reference"/>
                        </group>
                        <group string="En el proveedor">
                            <field name="provider_id"/>
                            <field name="provider_code"/>
                            <field name="provider_sku"/>
                            <field name="provider_ref"/>
                            <field name="brand"/>
                            <field name="brand_in_name"/>
                            <field name="code_match"/>
                            <field name="provider_description"/>
                            <field name="cost_provider_raw"/>
                        </group>
                    </group>
                    <group>
                        <group string="Presentación y costo">
                            <field name="multiplier"/>
                            <field name="price_has_tax"/>
                            <field name="cost_provider"/>
                            <field name="diff_pct"/>
                            <field name="confidence"/>
                        </group>
                        <group string="Por qué">
                            <field name="match_reason"/>
                            <field name="review_reason"/>
                            <field name="approved_by"/>
                            <field name="approved_on"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Notas de la decisión"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="apihub_product_link_view_search" model="ir.ui.view">
        <field name="name">apihub.product.link.search</field>
        <field name="model">apihub.product.link</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_tmpl_id"/>
                <field name="default_code"/>
                <field name="our_description_purchase"/>
                <field name="provider_sku"/>
                <field name="provider_description"/>
                <field name="provider_id"/>
                <filter name="review" string="Por revisar" domain="[('state', '=', 'review')]"/>
                <filter name="auto" string="Coincidencia segura" domain="[('state', '=', 'auto')]"/>
                <filter name="approved" string="Aprobados" domain="[('state', '=', 'approved')]"/>
                <filter name="rejected" string="Rechazados" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter name="multiplier_not_one" string="Con multiplicador distinto de 1" domain="[('multiplier', '!=', 1)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_provider" string="Proveedor" context="{'group_by': 'provider_id'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_reason" string="Motivo de revisión" context="{'group_by': 'review_reason'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_apihub_product_link" model="ir.actions.act_window">
        <field name="name">Equivalencias de productos</field>
        <field name="res_model">apihub.product.link</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_review': 1, 'search_default_group_provider': 1}</field>
    </record>

    <record id="server_action_link_approve" model="ir.actions.server">
        <field name="name">Aprobar seleccionados</field>
        <field name="model_id" ref="model_apihub_product_link"/>
        <field name="binding_model_id" ref="model_apihub_product_link"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_approve()</field>
    </record>

    <record id="server_action_link_reject" model="ir.actions.server">
        <field name="name">Rechazar seleccionados</field>
        <field name="model_id" ref="model_apihub_product_link"/>
        <field name="binding_model_id" ref="model_apihub_product_link"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_reject()</field>
    </record>
</odoo>
