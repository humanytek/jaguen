<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_apihub" model="ir.ui.view">
        <field name="name">product.template.form.apihub</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-block">
                    <field name="apihub_no_publish"/>
                    <label for="apihub_no_publish"/>
                </span>
                <span class="d-inline-block">
                    <field name="apihub_exact_margin"/>
                    <label for="apihub_exact_margin"/>
                </span>
                <span class="d-inline-block" invisible="not apihub_exact_margin">
                    <label for="apihub_price_round"/>
                    <field name="apihub_price_round" class="oe_inline"/>
                </span>
            </xpath>
        </field>
    </record>
</odoo>
