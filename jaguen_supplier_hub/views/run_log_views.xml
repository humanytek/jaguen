<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="apihub_run_log_view_list" model="ir.ui.view">
        <field name="name">apihub.run.log.list</field>
        <field name="model">apihub.run.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="run_date"/>
                <field name="provider_id"/>
                <field name="dry_run"/>
                <field name="approved_links"/>
                <field name="cost_updated"/>
                <field name="cost_same"/>
                <field name="lines_created"/>
                <field name="sanity_skipped"/>
                <field name="not_in_feed"/>
                <field name="reordered"/>
                <field name="avco_updated"/>
                <field name="rules_created"/>
                <field name="below_min"/>
            </list>
        </field>
    </record>

    <record id="action_apihub_run_log" model="ir.actions.act_window">
        <field name="name">Corridas</field>
        <field name="res_model">apihub.run.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
