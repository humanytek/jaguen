<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Columnas que NO deben salir por defecto en las lineas de la orden de venta / cotizacion
         (se pueden prender desde el menu de columnas y esa eleccion se respeta por usuario) -->
    <record id="view_order_form_columnas_jaguen" model="ir.ui.view">
        <field name="name">sale.order.form.columnas.jaguen</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_packaging_qty']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_packaging_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>

    <!-- Facturas de cliente: "Numero de Pedimento" no sale por defecto (se puede prender desde el menu de columnas).
         Prioridad alta para aplicarse despues de la vista de l10n_mx_edi_extended que agrega el campo. -->
    <record id="view_move_form_columnas_jaguen" model="ir.ui.view">
        <field name="name">account.move.form.columnas.jaguen</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='l10n_mx_edi_customs_number']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>
</odoo>
