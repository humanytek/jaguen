<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cotizacion hecha desde el carrito, sin firmar ni pagar: boton para regresar sus productos al carrito -->
    <template id="portal_back_to_cart" inherit_id="sale.sale_order_portal_template" name="Jaguen: regresar al carrito">
        <xpath expr="//div[@id='sale_order_sidebar_button']" position="inside">
            <form t-if="sale_order.website_id and sale_order.state == 'sent' and not sale_order.signature"
                  method="post" t-attf-action="/my/orders/#{sale_order.id}/back_to_cart" class="d-flex flex-column gap-1">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="access_token" t-att-value="sale_order.access_token"/>
                <button type="submit" class="btn btn-outline-primary"
                        onclick="return confirm('¿Regresar estos productos a tu carrito para modificarlos? Esta cotización se cancelará y se generará una nueva al terminar tu compra.');">
                    <i class="fa fa-pencil"/> Modificar
                </button>
            </form>
        </xpath>
    </template>
</odoo>
