<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pregunta obligatoria en el pago con PayPal: define la forma de pago del CFDI (04 / 28).
         Va ANTES del contenedor del boton de PayPal (el contenedor tiene name="o_payment_submit_button"
         y un clic dentro de el dispararia el pago). Se muestra por JS solo si la opcion es PayPal. -->
    <template id="payment_card_type" inherit_id="payment_paypal.payment_submit_button_inherit"
              name="JAGUEN - Pregunta credito/debito (PayPal)">
        <xpath expr="//div[@id='o_paypal_button_container']" position="before">
            <div id="jaguen_card_type_box" class="d-none mb-3">
                <label for="jaguen_card_type" class="form-label fw-bold">
                    ¿Con qué tarjeta pagarás en PayPal?
                </label>
                <select id="jaguen_card_type" name="jaguen_card_type" class="form-select">
                    <option value="">Selecciona una opción...</option>
                    <option value="credit">Tarjeta de crédito</option>
                    <option value="debit">Tarjeta de débito</option>
                </select>
                <div class="form-text">
                    Este dato se usa en tu factura y en tu complemento de pago. Elige la opción correcta.
                </div>
            </div>
        </xpath>
    </template>
</odoo>
