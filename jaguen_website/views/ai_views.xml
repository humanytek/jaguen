<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_jaguen_chat_session_tree" model="ir.ui.view">
        <field name="name">jaguen.chat.session.tree</field>
        <field name="model">jaguen.chat.session</field>
        <field name="arch" type="xml">
            <list string="Conversaciones del asistente web" decoration-warning="state == 'human'">
                <field name="create_date"/>
                <field name="name"/>
                <field name="mode"/>
                <field name="segment"/>
                <field name="company_name"/>
                <field name="ai_model"/>
                <field name="state"/>
                <field name="turn_count"/>
                <field name="lead_id"/>
            </list>
        </field>
    </record>

    <record id="view_jaguen_chat_session_form" model="ir.ui.view">
        <field name="name">jaguen.chat.session.form</field>
        <field name="model">jaguen.chat.session</field>
        <field name="arch" type="xml">
            <form string="Conversación del asistente web">
                <header>
                    <button name="action_return_to_ai" type="object" string="Devolver al asistente"
                            invisible="state != 'human'"/>
                    <button name="action_close" type="object" string="Cerrar" invisible="state == 'closed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="mode"/>
                            <field name="partner_id"/>
                            <field name="lead_id"/>
                            <field name="segment"/>
                            <field name="company_name"/>
                            <field name="is_buyer"/>
                            <field name="person_amount_ok"/>
                            <field name="hot"/>
                            <field name="hot_reasons"/>
                        </group>
                        <group>
                            <field name="ai_model"/>
                            <field name="turn_count"/>
                            <field name="tokens_in"/>
                            <field name="tokens_out"/>
                            <field name="ip_address"/>
                            <field name="last_activity"/>
                        </group>
                    </group>
                    <group string="Coincidencias en CRM y Ventas (posibles)">
                        <field name="match_info" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_jaguen_chat_session" model="ir.actions.act_window">
        <field name="name">Asistente web</field>
        <field name="res_model">jaguen.chat.session</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_jaguen_chat" name="Asistente web" action="action_jaguen_chat_session" sequence="95"/>
</odoo>
