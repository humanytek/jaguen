<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cada noche (00:10 hora de Hermosillo) se revuelve el orden de los productos de la tienda -->
        <record id="cron_rotar_catalogo" model="ir.cron">
            <field name="name">Tienda: rotar el orden de los productos una vez al día</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="state">code</field>
            <field name="code">model._jaguen_rotar_catalogo()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 07:10:00')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
    <!-- Primer revuelto al instalar o actualizar, para que los productos existentes no queden todos iguales -->
    <function model="product.template" name="_jaguen_rotar_catalogo"/>
    <!-- Las lineas en la tienda, en el mismo orden que en la pagina principal -->
    <function model="product.template" name="_jaguen_ordenar_lineas"/>
</odoo>
